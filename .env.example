# Public hostname used by Caddy. Point DNS to this server and allow ports 80/443.
DOMAIN=pos.localhost

# Database values: use separate strong passwords for the app user and root.
DB_NAME=fishpos
DB_USER=fishpos
DB_PASSWORD=replace-with-a-long-random-app-db-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

# App secrets. JWT_SECRET should be a random string of at least 32 characters.
JWT_SECRET=replace-with-a-different-long-random-root-password
ADMIN_USERNAME=fishpos
ADMIN_PASSWORD=replace-with-a-different-long-random-root-password

# Docker Hub image used by the app service.
APP_IMAGE=mikegemai101/fish-market-pos:latest
