# Public hostname used by Caddy. Point DNS to this server and allow ports 80/443.
DOMAIN=pos.example.com

# Database values: use separate strong passwords for the app user and root.
DB_NAME=fishpos
DB_USER=fishpos
DB_PASSWORD=replace-with-random-hex-secret
DB_ROOT_PASSWORD=replace-with-a-unique-random-hex-secret

# App secrets. JWT_SECRET should be a random string of at least 32 characters.
JWT_SECRET=generate-a-separate-64-character-hex-secret
ADMIN_USERNAME=fishpos
ADMIN_PASSWORD=generate-a-separate-admin-password-at-least-12-chars

# Docker Hub image used by the app service.
APP_IMAGE=mikegemai101/fish-market-pos:1.0.4
